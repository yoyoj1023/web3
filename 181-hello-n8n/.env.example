# 複製為 .env 後再啟動（首次啟動前設定 N8N_ENCRYPTION_KEY）
# cp .env.example .env

# Web UI 對外埠
N8N_PORT=5678

# 本機存取設定
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# 時區
GENERIC_TIMEZONE=Asia/Taipei
TZ=Asia/Taipei

# PostgreSQL（與 compose 內 postgres 服務對應）
POSTGRES_USER=n8n
POSTGRES_PASSWORD=n8n
POSTGRES_DB=n8n

# 至少 32 字元的隨機字串；首次啟動前設定，之後請勿更換
# 產生範例（PowerShell）：-join ((48..57) + (65..90) + (97..122) | Get-Random -Count 32 | ForEach-Object {[char]$_})
N8N_ENCRYPTION_KEY=please-change-me-before-first-run
